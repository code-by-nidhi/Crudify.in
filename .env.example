# Google Apps Script web app URL (see google-apps-script/Code.gs)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# Backward-compatible alias used by the contact API and older deployments
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# Must match the SHARED_SECRET script property in Apps Script
GOOGLE_SHEETS_SECRET=change-me-to-a-long-random-string
